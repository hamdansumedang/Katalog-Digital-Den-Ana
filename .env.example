# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
# PENTING untuk Blast WhatsApp: dipakai sebagai callback agar n8n bisa melaporkan
# status berhasil/gagal tiap nomor kembali ke app (status realtime di /blast).
APP_URL="MY_APP_URL"

# FONNTE_TOKEN: WhatsApp API Token from Fonnte
# Dipakai untuk notifikasi order (/api/notify)
FONNTE_TOKEN="sRzKLWyBBpBHbTkd2TVV"

# ---- Fitur Blast WhatsApp (lewat n8n + WAHA) ----
# CATATAN: App TIDAK mengakses WAHA langsung. WAHA bersifat internal di VPS
# (mis. http://waha:3000) dan hanya dipanggil dari n8n. Variabel WAHA
# (N8N_WAHA_BASE_URL / N8N_WAHA_API_KEY / N8N_WAHA_SESSION) di-set di sisi n8n,
# bukan di sini.

# N8N_WEBHOOK_URL: Production webhook workflow "WhatsApp Blast (WAHA)".
# App mengirim SELURUH daftar ke sini; n8n yang loop + interval per pesan.
# Path "wa-blast" sesuai file n8n/whatsapp-blast-waha.json.
N8N_WEBHOOK_URL="https://n8n.asy-syifaa.com/webhook/wa-blast"

# N8N_CHECK_WEBHOOK_URL: Production webhook workflow "WA Check Exists (WAHA)".
# Dipakai untuk cek nomor WhatsApp aktif (sinkron). Path "wa-check" sesuai
# file n8n/wa-check-exists.json.
N8N_CHECK_WEBHOOK_URL="https://n8n.asy-syifaa.com/webhook/wa-check"
